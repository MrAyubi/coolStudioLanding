# Dependencies and build artifacts are produced inside the image, never copied in.
node_modules/
**/node_modules/
website/dist/
website/.parcel-cache/
.cache/

# Browser-automation screenshots
website/.playwright-mcp/

# Version control and editor cruft
.git/
.gitignore
**/.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker's own files and docs - changing them shouldn't bust the build cache
Dockerfile
docker-compose.yml
.dockerignore
docs/
website/docs/
*.md
**/.claude/
