# Allowlist: exclude everything, then re-include only what the Dockerfile COPYs.
# Adding a new COPY source? Add a matching `!` line here, or the build fails
# with "not found".
*
!nginx.conf
!origin-cert.sh
!website/package.json
!website/package-lock.json
!website/src/

# Junk that can live inside the allowed paths. Unlike .gitignore, patterns
# here only match from the repo root, so `**/` is needed to match at any depth.
**/.DS_Store
**/Thumbs.db
**/.env*
website/src/deleted codes/
