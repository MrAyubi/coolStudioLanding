# Dependencies
node_modules/

# Build output
dist/

# Caches (Parcel 2 build cache, linters, npm)
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.npm/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables - never commit real values.
# Commit a .env.example with placeholder values instead.
.env
.env.*
*.env
!.env.example

# SSH keys and certificates - never commit, even public halves.
*.pem
*.key
*.pub
id_rsa*
id_ecdsa*
id_ed25519*

# Working docs (design notes, setup prompts describing the VPS) - kept local.
website/docs/*

# VPS deploy script and its guide - kept local, handed to developers directly.
/deploy.sh
/DEPLOY.md

# Machine-local tool and editor config
**/.claude/settings.local.json
.vscode/
.idea/
*.swp
*.swo

# MCP browser-automation screenshots
.playwright-mcp/

# OS files
.DS_Store
Thumbs.db
